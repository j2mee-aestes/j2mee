# === Public (safe for browser) ===
# Kakao Maps JavaScript key
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# Optional Firebase Auth / Storage (see docs/REQUIRED_KEYS.md)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# === App / Auth (server) ===
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_DEV_EMAIL=dev@padopado.local
AUTH_DEV_PASSWORD=change-me
INITIAL_ADMIN_EMAILS=dev@padopado.local

# Optional OAuth (server only — never NEXT_PUBLIC_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# === Database (server) ===
# Local SQLite or production Postgres URL
DATABASE_URL="file:./prisma/dev.db"

# === Weather / Waves — 기상청 (server) ===
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_API_KEY=
# 공공데이터포털 기상청 단기예보 인증키 (초단기실황/예보). 없으면 Open-Meteo로 실시간 대체.
KMA_API_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# 정적 배포(GitHub Pages)에서 브라우저 직접 호출이 필요할 때만 공개키로 사용
NEXT_PUBLIC_KMA_API_KEY=
MARINE_WEATHER_API_KEY=
KMA_MARINE_API_KEY=
KMA_MARINE_API_BASE_URL=

# Optional fishing restriction feed
FISHING_RESTRICTION_API_URL=

# === Ops ===
# false in production unless mock weather is intentional
ALLOW_MOCK_DATA=true

# Optional error monitoring (structure only until configured)
SENTRY_DSN=
