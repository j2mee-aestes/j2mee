// Prisma schema for 파도파도 auth + user data (SQLite locally, Postgres-ready URL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  preferredLocale  String    @default("ko")
  role             String    @default("user")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  favorites        FavoritePlace[]
  schedules        SavedSchedule[]
  activityRuns     ActivityRunRecord[]
  preference       UserPreference?
  auditLogs        AuditLog[]
  resolvedReports  PlaceReport[] @relation("ReportResolver")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FavoritePlace {
  id        String   @id @default(cuid())
  userId    String
  sourceId  String
  placeType String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId, placeType])
  @@index([userId])
}

model SavedSchedule {
  id        String   @id @default(cuid())
  userId    String
  title     String
  date      String
  status    String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ActivityRunRecord {
  id          String    @id @default(cuid())
  userId      String
  scheduleId  String?
  status      String
  payload     String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model UserPreference {
  userId               String   @id
  locale               String   @default("ko")
  defaultMapCenterLat  Float?
  defaultMapCenterLng  Float?
  notificationEnabled  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ManagedPlace {
  id                 String   @id @default(cuid())
  entityType         String
  sourceId           String
  recordStatus       String   @default("active")
  verificationStatus String   @default("unverified")
  name               String
  payload            String
  lastVerifiedAt     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([entityType, sourceId])
  @@index([entityType, recordStatus])
}

model PlaceReport {
  id             String    @id @default(cuid())
  entityType     String
  sourceId       String
  reportType     String
  status         String    @default("submitted")
  description    String
  placeNameSnapshot String?
  adminNote      String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([entityType, sourceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model TranslationReview {
  id           String   @id @default(cuid())
  messageKey   String
  locale       String
  text         String
  reviewStatus String   @default("machineTranslated")
  isSafety     Boolean  @default(false)
  reviewedBy   String?
  reviewedAt   DateTime?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([messageKey, locale])
  @@index([reviewStatus, isSafety])
}
