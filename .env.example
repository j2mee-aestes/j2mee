# Kakao Maps JavaScript SDK key (client)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# Weather / marine API (server-only, optional — mock used when empty)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=
MARINE_WEATHER_API_KEY=

# Database (SQLite for local; use Postgres URL in production)
DATABASE_URL="file:./prisma/dev.db"

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Dev credentials login (safe local fallback; do not use in production)
AUTH_DEV_EMAIL=dev@padopado.local
AUTH_DEV_PASSWORD=change-me

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Comma-separated emails promoted to admin on login/check
INITIAL_ADMIN_EMAILS=dev@padopado.local

# When false in production, prefer live providers over mock weather/etc.
ALLOW_MOCK_DATA=true
