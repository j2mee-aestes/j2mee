# === Public (safe for browser) ===
# Kakao Maps JavaScript key
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# === App / Auth (server) ===
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_DEV_EMAIL=dev@padopado.local
AUTH_DEV_PASSWORD=change-me
INITIAL_ADMIN_EMAILS=dev@padopado.local

# Optional OAuth (server only — never NEXT_PUBLIC_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# === Database (server) ===
# Local SQLite or production Postgres URL
DATABASE_URL="file:./prisma/dev.db"

# === Weather (server) ===
WEATHER_API_KEY=
WEATHER_API_BASE_URL=
MARINE_WEATHER_API_KEY=

# === Ops ===
# false in production unless mock weather is intentional
ALLOW_MOCK_DATA=true

# Optional error monitoring (structure only until configured)
SENTRY_DSN=
