<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GameBoost" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_jade</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="colorSurface">@color/bg_panel</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.GameBoost.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_jade</item>
        <item name="android:textColor">@color/bg_deep</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.GameBoost.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">10dp</item>
    </style>
</resources>
